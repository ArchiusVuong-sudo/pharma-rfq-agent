# Copy to .env or export in your shell. Every value here is optional.

# auto (default): live when a Claude Code login or ANTHROPIC_API_KEY is found, else replay
LLM_MODE=auto
# 1 forces replay mode (recorded model outputs, no login, no network)
DEMO_REPLAY=
# Model for live runs: claude-sonnet-5-5 (default), claude-opus-5-5 or claude-haiku-5-5
RFQ_MODEL=claude-sonnet-5-5
# Only needed when you do not use the local Claude Code login
ANTHROPIC_API_KEY=

# Web server
HOST=127.0.0.1
PORT=4103
# Where app data and LangGraph checkpoints live (two SQLite files)
RFQ_DATA_DIR=./data
# Replay waits this share of the recorded latency so the timeline streams (0 = instant)
REPLAY_DELAY_SCALE=0.35
# Inject a fault once per process to see the retry and the alert: registry_timeout
FAULT_ONCE=
